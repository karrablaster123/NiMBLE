Screen {
    layout: grid;
    grid-size: 2;          /* Switched to a 2-column layout for perfect symmetry */
    padding: 1;
    background: #181818;
}

Header {
    dock: top;
    height: 3;
    content-align: center middle;
    background: #181818;
    color: white;
}

/* Consolidated styles for all Digits display boxes */
#raw-weight, #weight, #flow, #flow2 {
    width: 100%;
    height: 7;             /* Fixed height prevents the boxes from collapsing */
    text-align: center;
    border: round grey;
    content-align: center middle;
    text-style: bold;
}

Button {
    width: 100%;
    height: 3;
    text-align: center;
    content-align: center middle;
    color: black;            /* Ensures text is black */
}

Button.-primary {
    background: dodgerblue;  /* Adjust to your preferred blue */
}

Button.-primary:focus {
    background: dodgerblue;  /* Keeps background blue on focus */
    color: black;
}

Button.-primary > .button--label {
    background: transparent; /* Removes the white highlight box behind the text */
    color: black;
}
/* Footer & Status Information */
#status, #details {
    width: 100%;
    height: 2;
    column-span: 2;        /* Span across both columns at the bottom */
    text-align: center;
    content-align: center middle;
}

/* History Screen Layout */
HistoryScreen {
    layout: vertical;
}

HistoryScreen Horizontal {
    width: 100%;
    height: 1fr;
}

PlotextPlot {
    width: 1fr;
    height: 1fr;
}
